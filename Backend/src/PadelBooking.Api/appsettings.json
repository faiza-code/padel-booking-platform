{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=PadelBookingDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000" ]
  },
  "Jwt": {
    "Key": "REPLACE_THIS_WITH_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS",
    "Issuer": "PadelBookingApi",
    "Audience": "PadelBookingClient",
    "ExpiryMinutes": 120
  },
  "Admin": {
    "DefaultUsername": "admin",
    "DefaultPassword": "Admin@12345"
  },
  "Thawani": {
    "BaseUrl": "https://uatcheckout.thawani.om/api/v1/",
    "SecretKey": "PUT_YOUR_THAWANI_SANDBOX_SECRET_KEY_HERE",
    "PublishableKey": "PUT_YOUR_THAWANI_SANDBOX_PUBLISHABLE_KEY_HERE",
    "SuccessUrl": "http://localhost:5173/payment/success",
    "CancelUrl": "http://localhost:5173/payment/cancel"
  }
}
